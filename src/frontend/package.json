{
  "name": "hackbrew-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src vite.config.ts --max-warnings 0",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json eslint.config.mjs",
    "format-check": "prettier --check src index.html vite.config.ts tsconfig.json package.json eslint.config.mjs"
  },
  "dependencies": {
    "chart.js": "4.6.1",
    "vue": "3.5.44"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14"
  }
}
