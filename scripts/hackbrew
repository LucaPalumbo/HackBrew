#!/bin/sh
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_root"

action=${1:-help}
if [ "$#" -gt 0 ]; then
    shift
fi

case "$action" in
    prototype)
        export COMPOSE_PROJECT_NAME=hackbrew-ui-prototype
        export MONGODB_DATABASE=hackbrew_prototype
        export HACKBREW_BIND_ADDRESS=127.0.0.1
        export HACKBREW_PORT=18090
        export HACKBREW_FRONTEND_PORT=15173
        case "${1:-up}" in
            up)
                docker compose -f compose.yaml -f compose.dev.yaml -f compose.prototype.yaml --profile dev up --build --detach --wait app frontend
                printf '%s\n' 'Prototype: http://localhost:15173/?variant=A'
                ;;
            format)
                docker compose --project-name hackbrew-ui-prototype -f compose.yaml -f compose.dev.yaml exec -T frontend npm run format
                ;;
            check)
                docker compose --project-name hackbrew-ui-prototype -f compose.yaml -f compose.dev.yaml exec -T frontend npm run lint
                docker compose --project-name hackbrew-ui-prototype -f compose.yaml -f compose.dev.yaml exec -T frontend npm run build
                ;;
            capture)
                docker compose -f compose.yaml -f compose.dev.yaml -f compose.prototype.yaml run --rm --build --no-deps -T prototype-browser python scripts/prototype-preview.py
                ;;
            down)
                docker compose -f compose.yaml -f compose.dev.yaml -f compose.prototype.yaml --profile dev --profile tools down
                ;;
            *) printf '%s\n' 'Usage: ./scripts/hackbrew prototype [up|format|check|capture|down]'; exit 2 ;;
        esac
        ;;
    up)
        docker compose -f compose.yaml up --build --detach --wait "$@"
        ;;
    down)
        docker compose -f compose.yaml --profile dev --profile tools down "$@"
        ;;
    build)
        docker compose -f compose.yaml build app "$@"
        ;;
    simulator)
        docker compose -f compose.yaml up --build --detach --wait thermal-simulator "$@"
        ;;
    dev)
        docker compose -f compose.yaml -f compose.dev.yaml --profile dev up --build "$@"
        ;;
    lint)
        docker compose -f compose.yaml run --rm --build --user "$(id -u):$(id -g)" backend-tools ruff check src/hackbrew tests
        docker compose -f compose.yaml run --rm --build --user "$(id -u):$(id -g)" frontend npm run lint
        ;;
    format)
        docker compose -f compose.yaml run --rm --build --user "$(id -u):$(id -g)" backend-tools ruff format src/hackbrew tests
        docker compose -f compose.yaml run --rm --build --user "$(id -u):$(id -g)" frontend npm run format
        ;;
    format-check)
        docker compose -f compose.yaml run --rm --build --user "$(id -u):$(id -g)" backend-tools ruff format --check src/hackbrew tests
        docker compose -f compose.yaml run --rm --build --user "$(id -u):$(id -g)" frontend npm run format-check
        ;;
    typecheck)
        docker compose -f compose.yaml run --rm --build --user "$(id -u):$(id -g)" backend-tools mypy
        docker compose -f compose.yaml run --rm --build --user "$(id -u):$(id -g)" frontend npm run typecheck
        ;;
    test|test-recovery)
        if [ "$action" = test-recovery ]; then
            case "$*" in
                ''|assembled) ;;
                *) printf '%s\n' 'Usage: ./scripts/hackbrew test-recovery [assembled]'; exit 2 ;;
            esac
        fi
        hackbrew_tests_project="hackbrew-tests-$$"
        cleanup() {
            test_exit_code=$?
            trap - EXIT
            docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml down --volumes --remove-orphans
            exit "$test_exit_code"
        }
        trap cleanup EXIT
        if [ -n "${HACKBREW_GATEWAY_TOKEN:-}" ]; then
            docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml -f compose.bridge-auth.yaml build app tests thermal-heating thermal-heating-secondary thermal-cooling thermal-both
        else
            docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml build app tests thermal-heating thermal-heating-secondary thermal-cooling thermal-both
        fi
        docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml up --detach --wait app
        if [ "$action" = test ]; then
            docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml run --rm tests pytest "$@"
        fi
        if [ "$action" = test ] && [ "$#" -eq 0 ]; then
            for hackbrew_restart_phase in upgrade persistence; do
                hackbrew_restart_state=$(docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml run --rm -T tests python -m tests.check_restart "$hackbrew_restart_phase-seed")
                docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml restart app
                docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml up --detach --wait app
                printf '%s\n' "$hackbrew_restart_state" | docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml run --rm -T tests python -m tests.check_restart "$hackbrew_restart_phase-verify"
            done
        fi
        if [ "$action" = test-recovery ] || [ "$#" -eq 0 ]; then
            "$project_root/scripts/check-recovery" "$hackbrew_tests_project" "${1:-all}"
        fi
        ;;
    check)
        "$0" format-check
        "$0" lint
        "$0" typecheck
        "$0" test
        ;;
    help)
        printf '%s\n' 'Usage: ./scripts/hackbrew {up|down|build|dev|prototype [up|format|check|capture|down]|simulator|lint|format|format-check|typecheck|test [pytest arguments]|test-recovery [assembled]|check}'
        ;;
    *)
        printf '%s\n' "Unknown command: $action" >&2
        exit 2
        ;;
esac
