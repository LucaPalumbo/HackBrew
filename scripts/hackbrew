#!/bin/sh
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_root"

action=${1:-help}
if [ "$#" -gt 0 ]; then
    shift
fi

case "$action" in
    up)
        docker compose -f compose.yaml up --build --detach --wait "$@"
        ;;
    down)
        docker compose -f compose.yaml --profile dev --profile tools down "$@"
        ;;
    build)
        docker compose -f compose.yaml build app "$@"
        ;;
    simulator)
        docker compose -f compose.yaml up --build --detach --wait thermal-simulator "$@"
        ;;
    dev)
        docker compose -f compose.yaml -f compose.dev.yaml --profile dev up --build "$@"
        ;;
    lint)
        docker compose -f compose.yaml run --rm --build --user "$(id -u):$(id -g)" backend-tools ruff check src/hackbrew tests
        docker compose -f compose.yaml run --rm --build --user "$(id -u):$(id -g)" frontend npm run lint
        ;;
    format)
        docker compose -f compose.yaml run --rm --build --user "$(id -u):$(id -g)" backend-tools ruff format src/hackbrew tests
        docker compose -f compose.yaml run --rm --build --user "$(id -u):$(id -g)" frontend npm run format
        ;;
    format-check)
        docker compose -f compose.yaml run --rm --build --user "$(id -u):$(id -g)" backend-tools ruff format --check src/hackbrew tests
        docker compose -f compose.yaml run --rm --build --user "$(id -u):$(id -g)" frontend npm run format-check
        ;;
    typecheck)
        docker compose -f compose.yaml run --rm --build --user "$(id -u):$(id -g)" backend-tools mypy
        docker compose -f compose.yaml run --rm --build --user "$(id -u):$(id -g)" frontend npm run typecheck
        ;;
    test|test-recovery)
        hackbrew_tests_project="hackbrew-tests-$$"
        cleanup() {
            test_exit_code=$?
            trap - EXIT
            docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml down --volumes --remove-orphans
            exit "$test_exit_code"
        }
        trap cleanup EXIT
        if [ -n "${HACKBREW_GATEWAY_TOKEN:-}" ]; then
            docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml -f compose.bridge-auth.yaml build app tests thermal-heating thermal-cooling thermal-both
        else
            docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml build app tests thermal-heating thermal-cooling thermal-both
        fi
        docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml up --detach --wait app
        if [ "$action" = test ]; then
            docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml run --rm tests pytest "$@"
        fi
        if [ "$action" = test ] && [ "$#" -eq 0 ]; then
            for hackbrew_restart_phase in upgrade persistence; do
                hackbrew_restart_state=$(docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml run --rm -T tests python -m tests.check_restart "$hackbrew_restart_phase-seed")
                docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml restart app
                docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml up --detach --wait app
                printf '%s\n' "$hackbrew_restart_state" | docker compose --project-name "$hackbrew_tests_project" -f compose.test.yaml run --rm -T tests python -m tests.check_restart "$hackbrew_restart_phase-verify"
            done
        fi
        if [ "$action" = test-recovery ] || [ "$#" -eq 0 ]; then
            "$project_root/scripts/check-recovery" "$hackbrew_tests_project"
        fi
        ;;
    check)
        "$0" format-check
        "$0" lint
        "$0" typecheck
        "$0" test
        ;;
    help)
        printf '%s\n' 'Usage: ./scripts/hackbrew {up|down|build|dev|simulator|lint|format|format-check|typecheck|test [pytest arguments]|test-recovery|check}'
        ;;
    *)
        printf '%s\n' "Unknown command: $action" >&2
        exit 2
        ;;
esac
